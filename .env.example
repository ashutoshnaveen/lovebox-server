# Shared passcode for the sender web page
LOVEBOX_PASSCODE=change-me-to-a-strong-secret

# Per-device secret keys (one per deviceId)
# Format: DEVICE_KEY_{deviceId in uppercase with hyphens replaced by underscores}
DEVICE_KEY_LOVEBOX_001=change-me-to-a-random-device-secret

# Optional remote OTA release metadata. Keep the binary outside the source repo.
FIRMWARE_VERSION_LATEST=1.0.1
FIRMWARE_BINARY_URL=https://example.com/lovebox-1.0.1.bin
FIRMWARE_SHA256=replace-with-64-character-sha256

# Optional upload size limits (bytes). Defaults shown if unset.
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=5242880

# Optional audio conversion limits for the sender UI.
# MAX_AUDIO_BYTES: maximum source audio file size in bytes (default 10 MB).
# MAX_AUDIO_SECONDS: maximum converted audio length in seconds (default 120).
# Increase MAX_AUDIO_SECONDS to allow longer voice notes / songs.
VITE_MAX_AUDIO_BYTES=10485760
VITE_MAX_AUDIO_SECONDS=120

# Netlify Blobs context is injected automatically by Netlify CLI and production.
# Do not set this manually unless you know what you are doing.
# NETLIFY_BLOBS_CONTEXT=
